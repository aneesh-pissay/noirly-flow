# Noirly Flow
NEXT_PUBLIC_APP_URL=http://localhost:3002
AUTH_URL=http://localhost:3002
AUTH_SECRET=replace-with-at-least-32-chars-of-random-data
AUTH_TRUST_HOST=true

# Same Mongo host as Identity; different database name
MONGODB_URI=mongodb://127.0.0.1:27017/noirly-flow

# Noirly Identity OIDC (from identity `npm run db:seed` — paste the printed secret)
AUTH_NOIRLY_ISSUER=http://localhost:3000
AUTH_NOIRLY_CLIENT_ID=noirly-flow
AUTH_NOIRLY_CLIENT_SECRET=

# Public Identity URL for Google One Tap and “Open Identity” links
NEXT_PUBLIC_IDENTITY_URL=http://localhost:3000

# noirly-realtime (run `pnpm --filter @noirly/realtime-server dev` in noirly-realtime)
REALTIME_JWT_SECRET=dev-noirly-realtime-jwt-secret-change-me-32
REALTIME_JWT_ISSUER=noirly-flow
REALTIME_JWT_AUDIENCE=noirly-realtime
REALTIME_INTERNAL_URL=http://127.0.0.1:4001
REALTIME_INTERNAL_SECRET=dev-noirly-realtime-jwt-secret-change-me-32
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:4001/ws

# Only trust a header that your ingress replaces/controls. Rightmost address wins.
TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Invite emails ("Invite by email" on the Members page) go out over SMTP — the
# same setup as Noirly Identity and the portfolio, so the same credentials work.
# In development, leaving these unset logs the invite link to the server console.
# In production they are required, or emailed invites fail (invite links still work).
# Gmail: use an App Password (Google Account → Security → App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Noirly Flow <you@gmail.com>"
# Comment @mention emails use the same SMTP settings. Strong random secret for
# the authenticated daily retry worker (initial delivery runs after posting).
# CRON_SECRET=
# Local preview only: writes mention emails here instead of sending them.
# MENTION_EMAIL_OUTBOX=.mention-outbox
# Assignment/completion emails and daily overdue reminders share SMTP and CRON_SECRET.
# Local preview only; leave unset in production.
# TASK_EMAIL_OUTBOX=.task-outbox
# Write invite emails to this folder instead of sending them (local preview / tests).
# INVITE_EMAIL_OUTBOX=.invite-outbox

# Task attachments are stored in Cloudflare R2. Browser uploads use short-lived
# presigned PUT URLs; downloads stay private behind Flow's authorized API route.
# Create a bucket-scoped R2 API token with Object Read & Write access.
# Configure bucket CORS for PUT, Content-Type, and your Flow site origin.
# Expire the flow/attachment-uploads/ prefix after one day to clean unfinished uploads.
# In development, leaving these unset stores files in ./.attachments instead.
# In production they are required, or uploads fail with "Attachments aren't set up".
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Two-way calendar sync (Settings → Two-way calendar sync). Each calendar shows
# up once its client ID and secret are set, and CALENDAR_TOKEN_KEY is set.
# Encrypts calendar OAuth tokens at rest: 32 random bytes, base64
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# CALENDAR_TOKEN_KEY=
# Google Cloud console → APIs & Services: enable the Google Calendar API, add an
# OAuth client (Web application) with the redirect URI
#   <NEXT_PUBLIC_APP_URL>/api/calendar-sync/google/callback
# and the scopes openid, email and .../auth/calendar.app.created.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Azure portal → App registrations: a web app, any org directory and personal
# Microsoft accounts, redirect URI <NEXT_PUBLIC_APP_URL>/api/calendar-sync/outlook/callback,
# delegated Microsoft Graph permissions offline_access, openid, email, Calendars.ReadWrite.
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# Sync runs every couple of minutes while someone has Flow open; for people who
# don't, call GET /api/cron/calendar-sync (Bearer CRON_SECRET) from a scheduler
# every 5–15 minutes. (Vercel's daily crons are too slow for this.)

# Docs tutorial videos (Docs tab) play from the video bucket's Public Development URL
# (R2 → bucket → Settings), as <R2_PUBLIC_URL>/doc-videos/<article-id>.mp4 (see src/docs/video-host.ts).
# Just the origin, no path. Without it, articles say their walkthrough is coming.
# R2_PUBLIC_URL=https://pub-<id>.r2.dev
